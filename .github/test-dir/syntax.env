# comment line

PLAIN=value
SPACED = spaced value
EMPTY=
SINGLE='single quoted # not a comment'
DOUBLE="double quoted # not a comment"
INLINE=before # inline comment
WITH_EQUALS=a=b=c
export EXPORTED=exported
MULTILINE="line1
line2"
NEWLINE_ESCAPE="a\nb"
URL=https://example.com/path?x=1&y=2
BACKTICK=`back tick`
