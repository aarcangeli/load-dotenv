{
  "name": "typescript-action",
  "description": "Read .env file and export variables to $GITHUB_ENV",
  "version": "1.1.0",
  "author": "Alessandro Arcangeli <alessandroarcangeli.rm@gmail.com>",
  "private": true,
  "homepage": "https://github.com/aarcangeli/load-dotenv",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc && line-endings -l LF -w lib/**",
    "format": "prettier --write src/**/*.ts *.mjs",
    "format-check": "prettier --check src/**/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "generate-docs": "node lib/misc/generate-docs.js",
    "eslint:inspector": "eslint-config-inspector",
    "all": "yarn build && yarn format && yarn lint && yarn generate-docs && yarn package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.0",
    "@folkforms/line-endings": "^0.0.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vercel/ncc": "^0.45.0",
    "dotenv": "^18.0.7",
    "dotenv-expand": "^1000.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^3.5.0"
  }
}
